{
	"name": "kalai",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"db:start": "SUPABASE_SERVICES_HOSTNAME=host.docker.internal supabase start --ignore-health-check && npm run db:env",
		"db:stop": "supabase stop",
		"db:reset": "SUPABASE_SERVICES_HOSTNAME=host.docker.internal supabase db reset && npm run db:env",
		"db:status": "supabase status",
		"db:env": "node scripts/sync-env.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"daisyui": "^5.7.9",
		"supabase": "^2.111.0",
		"svelte": "^5.16.0",
		"svelte-check": "^4.1.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.7"
	},
	"dependencies": {
		"@supabase/ssr": "^0.5.2",
		"@supabase/supabase-js": "^2.48.1",
		"cally": "^0.9.2",
		"lucide-svelte": "^0.474.0",
		"theme-change": "^3.0.4"
	}
}
